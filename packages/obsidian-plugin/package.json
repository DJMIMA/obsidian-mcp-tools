{
	"name": "@obsidian-mcp-tools/obsidian-plugin",
	"description": "The Obsidian plugin component for MCP Tools, enabling secure connections between Obsidian and Claude Desktop through the Model Context Protocol (MCP).",
	"keywords": [
		"MCP",
		"Claude",
		"Chat"
	],
	"license": "MIT",
	"author": "Jack Steam",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "bun run check && bun bun.config.ts --prod",
		"check": "tsc --noEmit",
		"test": "bun test src",
		"dev": "bun --watch run bun.config.ts --watch",
		"link": "bun scripts/link.ts",
		"release": "run-s build zip",
		"zip": "bun scripts/zip.ts"
	},
	"dependencies": {
		"@types/fs-extra": "^11.0.4",
		"arktype": "^2.2.9",
		"fs-extra": "^11.4.1",
		"obsidian-local-rest-api": "^5.3.0",
		"radash": "^12.1.1",
		"rxjs": "^7.8.2",
		"semver": "^7.8.6",
		"shared": "workspace:*",
		"svelte": "^5.57.3",
		"svelte-preprocess": "^6.0.5"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/express": "^4.17.25",
		"@types/node": "^26.6.6",
		"@types/semver": "^7.8.0",
		"archiver": "^8.0.0",
		"obsidian": "latest",
		"tslib": "2.9.1",
		"typescript": "^7.0.2"
	}
}